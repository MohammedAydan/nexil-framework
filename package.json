{
  "name": "nexil",
  "version": "0.1.0",
  "private": true,
  "description": "HTML-first, resumable TypeScript web framework",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./examples/*\" build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "clean": "node scripts/clean.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:edge": "node tests/parity/miniflare-smoke.mjs",
    "test:parity": "vitest run tests/parity/runtime-parity.test.ts",
    "test:node-runtime": "node tests/parity/node-smoke.mjs",
    "test:deno": "deno run --allow-read --allow-env tests/parity/deno-smoke.ts",
    "test:deno:e2e": "deno run --allow-read --allow-env tests/e2e/deno-runtime.spec.ts",
    "typecheck": "tsc -b",
    "security": "pnpm audit --audit-level high",
    "budget": "pnpm --filter @nexil/compiler test:budget",
    "check:budget": "pnpm budget",
    "bench:compare": "node examples/nexil-showcase/benchmarks/compare-astro.mjs",
    "bench:lighthouse": "node examples/nexil-showcase/benchmarks/run-lighthouse.mjs",
    "bench:production": "pnpm --filter @nexil/example-nexil-showcase build && pnpm --filter @nexil/example-nexil-showcase bench",
    "publish:github": "pnpm -C packages publish -r --no-git-checks --access public",
    "publish:github:dry": "pnpm -C packages publish -r --no-git-checks --dry-run --access public",
    "release:check": "pnpm -C packages publish -r --no-git-checks --dry-run --tag next --access public",
    "publish:npm": "pnpm -r publish --access public --no-git-checks --no-provenance",
    "publish:npm:dry": "node scripts/validate-tarballs.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@playwright/test": "^1.62.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.0.0",
    "lighthouse": "^13.4.1",
    "magic-string": "^0.30.21",
    "miniflare": "5.20260820.0-alpha",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "sharp": "0.35.3"
  }
}
