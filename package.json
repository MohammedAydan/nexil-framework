{
  "name": "nexis",
  "version": "0.1.0",
  "private": true,
  "description": "HTML-first, resumable TypeScript web framework",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "find packages examples -type d -name dist -prune -exec rm -rf {} + && find packages examples -name '*.tsbuildinfo' -delete && pnpm -r --sort build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:edge": "node tests/parity/miniflare-smoke.mjs",
    "test:node-runtime": "node tests/parity/node-smoke.mjs",
    "test:deno": "deno run --allow-read tests/parity/deno-smoke.ts",
    "typecheck": "tsc -b",
    "security": "pnpm audit --audit-level high",
    "budget": "pnpm --filter @nexis/compiler test:budget"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "magic-string": "^0.30.21",
    "miniflare": "5.20260820.0-alpha",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
