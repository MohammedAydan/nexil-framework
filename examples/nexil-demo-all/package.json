{
  "name": "nexil-demo-all",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node ../../packages/cli/dist/bin.js dev",
    "build": "node ../../packages/cli/dist/bin.js build",
    "start": "node ../../packages/cli/dist/bin.js start",
    "typecheck": "tsc --noEmit",
    "check": "node ../../packages/cli/dist/bin.js check --budget",
    "analyze": "node ../../packages/cli/dist/bin.js analyze"
  },
  "dependencies": {
    "@nexil/cli": "workspace:*",
    "@nexil/core": "workspace:*"
  },
  "devDependencies": {
    "@nexil/vite-plugin": "workspace:*",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  },
  "nexil": {
    "routeExtension": "tsx",
    "source": "npm",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
