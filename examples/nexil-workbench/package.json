{
  "name": "@nexil/example-nexil-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node ../../packages/cli/dist/bin.js dev",
    "build": "node ../../packages/cli/dist/bin.js build",
    "start": "node ../../packages/cli/dist/bin.js start",
    "typecheck": "tsc --noEmit",
    "check": "node ../../packages/cli/dist/bin.js check --budget",
    "test": "vitest run tests/support-action.test.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm check && pnpm build"
  },
  "dependencies": {
    "@nexil/actions": "workspace:*",
    "@nexil/cli": "workspace:*",
    "@nexil/core": "workspace:*",
    "@nexil/jsx-runtime": "workspace:*",
    "@nexil/reactivity": "workspace:*",
    "@nexil/router": "workspace:*",
    "@nexil/security": "workspace:*",
    "@nexil/seo": "workspace:*",
    "@nexil/server": "workspace:*",
    "@nexil/state": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
