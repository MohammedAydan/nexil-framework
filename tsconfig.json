{
  "files": [],
  "references": [
    { "path": "./packages/nexil" },
    { "path": "./packages/vite-plugin" },
    { "path": "./packages/cli" },
    { "path": "./packages/create-nexil" },
    { "path": "./examples/hello" },
    { "path": "./examples/blog" },
    { "path": "./examples/ecommerce" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@nexil/nexil": ["./packages/nexil/src/index.ts"],
      "@nexil/nexil/*": ["./packages/nexil/src/*"],
      "nexil": ["./packages/nexil/src/index.ts"],
      "nexil/*": ["./packages/nexil/src/*"],
      "@nexil/vite-plugin": ["./packages/vite-plugin/src/index.ts"],
      "@nexil/cli": ["./packages/cli/src/index.ts"],
      "create-nexil": ["./packages/create-nexil/src/scaffold.ts"]
    }
  }
}
