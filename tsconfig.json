{
  "files": [],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/reactivity" },
    { "path": "./packages/jsx-runtime" },
    { "path": "./packages/renderer" },
    { "path": "./packages/client" },
    { "path": "./packages/compiler" },
    { "path": "./packages/router" },
    { "path": "./packages/seo" },
    { "path": "./packages/media" },
    { "path": "./packages/css" },
    { "path": "./packages/server" },
    { "path": "./packages/actions" },
    { "path": "./packages/state" },
    { "path": "./packages/adapters" },
    { "path": "./packages/cli" },
    { "path": "./packages/dev-server" },
    { "path": "./examples/hello" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@nexis/core": ["packages/core/src/index.ts"],
      "@nexis/reactivity": ["packages/reactivity/src/index.ts"],
      "@nexis/jsx-runtime": ["packages/jsx-runtime/src/index.ts"],
      "@nexis/jsx-runtime/jsx-runtime": ["packages/jsx-runtime/src/jsx-runtime.ts"],
      "@nexis/renderer": ["packages/renderer/src/index.ts"],
      "@nexis/client": ["packages/client/src/index.ts"],
      "@nexis/compiler": ["packages/compiler/src/index.ts"],
      "@nexis/router": ["packages/router/src/index.ts"],
      "@nexis/seo": ["packages/seo/src/index.ts"],
      "@nexis/media": ["packages/media/src/index.ts"],
      "@nexis/css": ["packages/css/src/index.ts"],
      "@nexis/server": ["packages/server/src/index.ts"],
      "@nexis/actions": ["packages/actions/src/index.ts"],
      "@nexis/state": ["packages/state/src/index.ts"],
      "@nexis/adapters": ["packages/adapters/src/index.ts"],
      "@nexis/cli": ["packages/cli/src/index.ts"],
      "@nexis/dev-server": ["packages/dev-server/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
