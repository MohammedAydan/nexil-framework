{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@nexil/core": ["../nexil/src/index.ts"],
      "@nexil/core/server": ["../nexil/src/server/index.ts"],
      "@nexil/core/router": ["../nexil/src/router/index.ts"],
      "@nexil/core/client": ["../nexil/src/client/index.ts"],
      "@nexil/core/jsx-runtime": ["../nexil/src/jsx-runtime/index.ts"],
      "@nexil/core/jsx-dev-runtime": ["../nexil/src/jsx-runtime/jsx-runtime.ts"],
      "@nexil/nexil": ["../nexil/src/index.ts"],
      "@nexil/nexil/server": ["../nexil/src/server/index.ts"],
      "@nexil/nexil/router": ["../nexil/src/router/index.ts"],
      "@nexil/nexil/client": ["../nexil/src/client/index.ts"],
      "@nexil/nexil/jsx-runtime": ["../nexil/src/jsx-runtime/index.ts"],
      "@nexil/nexil/jsx-dev-runtime": ["../nexil/src/jsx-runtime/jsx-runtime.ts"],
      "nexil": ["../nexil/src/index.ts"],
      "nexil/server": ["../nexil/src/server/index.ts"],
      "nexil/router": ["../nexil/src/router/index.ts"],
      "nexil/client": ["../nexil/src/client/index.ts"],
      "nexil/jsx-runtime": ["../nexil/src/jsx-runtime/index.ts"],
      "nexil/jsx-dev-runtime": ["../nexil/src/jsx-runtime/jsx-runtime.ts"],
      "@nexil/vite-plugin": ["../vite-plugin/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../nexil" }, { "path": "../vite-plugin" }]
}
