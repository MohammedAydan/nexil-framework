{
  "name": "@nexil/cli",
  "version": "0.2.3",
  "description": "Next-generation CLI toolchain and production server for Nexil",
  "type": "module",
  "license": "MIT",
  "author": "Mohammed Aydan <mohammed@nexil.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAydan/nexil-framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "nexil": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "test": "vitest run"
  },
  "dependencies": {
    "create-nexil": "workspace:*",
    "@nexil/vite-plugin": "workspace:*",
    "esbuild": "^0.25.0",
    "mime-types": "^2.1.35",
    "@nexil/core": "workspace:*",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/prompts": "^2.4.9"
  }
}
