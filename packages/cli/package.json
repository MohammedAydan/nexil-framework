{
  "name": "@nexis/cli",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@nexis/compiler": "workspace:*",
    "@nexis/core": "workspace:*",
    "@nexis/dev-server": "workspace:*",
    "@nexis/media": "workspace:*",
    "@nexis/renderer": "workspace:*",
    "@nexis/og-image": "workspace:*",
    "@nexis/serve": "workspace:*",
    "@nexis/starter": "workspace:*",
    "@nexis/router": "workspace:*",
    "@nexis/seo": "workspace:*",
    "@nexis/vite-plugin": "workspace:*",
    "vite": "^7.3.6"
  },
  "bin": {
    "nexis": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('fs');for(const f of ['dist','tsconfig.tsbuildinfo']){try{fs.rmSync(f,{recursive:true,force:true})}catch(e){}}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAydan/nexis-framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ]
}
