{
  "name": "@nexil/vite-plugin",
  "version": "0.0.2",
  "type": "module",
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@nexil/compiler": "workspace:*",
    "magic-string": "^0.30.21",
    "vite": "^7.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('fs');for(const f of ['dist','tsconfig.tsbuildinfo']){try{fs.rmSync(f,{recursive:true,force:true})}catch(e){}}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAydan/nexil-framework.git",
    "directory": "packages/vite-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ]
}
