{
  "name": "create-nexil",
  "version": "0.1.4",
  "description": "Create a Nexil application",
  "type": "module",
  "main": "./dist/scaffold.js",
  "module": "./dist/scaffold.js",
  "types": "./dist/scaffold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    }
  },
  "bin": {
    "create-nexil": "dist/bin.js",
    "create-nexil-app": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAydan/nexil-framework.git",
    "directory": "packages/create-nexil"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('fs');for(const f of ['dist','tsconfig.tsbuildinfo']){try{fs.rmSync(f,{recursive:true,force:true})}catch(e){}}\""
  },
  "license": "MIT",
  "author": "Mohammed Aydan <mohammed@nexil.dev>"
}
